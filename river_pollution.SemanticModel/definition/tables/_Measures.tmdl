	measure 'Above Range Count' = CALCULATE([Sample Count], FactRiverPollution[Result_Qualifier] = ">")
		formatString: 0
		lineageTag: 67c11682-3d20-4202-8bbc-685eac195168

	/// Denominator's bacteria set matches [Exceedance Count] below — kept as a literal IN list
	/// here too (rather than only in one place) since DAX measures can't share a local variable.
	/// Numerator is coalesced to 0 before DIVIDE: [Exceedance Count]'s own CALCULATE(FILTER(...))
	/// legitimately returns BLANK (not 0) whenever nothing in context can match its "> 400 or
	/// TNTC" condition — e.g. a genuinely clean site/year, or the Exceedance Bucket slicer itself
	/// narrowed to "Below 400" (same quirk already called out in [Positive:Negative Ratio Color]'s
	/// comment). Left uncoalesced, that BLANK propagates through DIVIDE (blank numerator -> blank
	/// result even with a valid nonzero denominator) and makes a 0%-exceedance site indistinguishable
	/// from [Cleanliness Score]'s "untested, no fecal-indicator samples in context" BLANK case —
	/// which is what made a location with 9/9 clean samples show up as a blank gauge instead of 100%.
	/// The denominator itself is deliberately left un-coalesced: TestedCount = 0/BLANK still needs
	/// to make this whole measure BLANK, since that's the real "untested" signal everything
	/// downstream ([Cleanliness Score], [Cleanest Rank], [Most Polluted Rank]) keys off.
	measure 'Exceedance %' =
			VAR TestedCount =
			    CALCULATE(
			        CALCULATE([Sample Count], KEEPFILTERS(DimBacterialIndex[Bacterial index] IN {"קוליפורם צואתי", "E.coli MUG", "סטרפטוקוק/אנטרוקוק ממוצא צואתי"})),
			        REMOVEFILTERS(FactRiverPollution[Exceedance Bucket])
			    )
			VAR ExceedanceCountSafe =
			    IF(ISBLANK([Exceedance Count]), 0, [Exceedance Count])
			RETURN
			    DIVIDE(ExceedanceCountSafe, TestedCount)
		formatString: 0.0%
		lineageTag: b28986cd-8de0-46f8-90f2-55058649afbc

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// A TNTC reading ("plate covered" — literally too many colonies to count) has
	/// Result_Numeric = BLANK, so a plain `Result_Numeric > 400` condition silently
	/// evaluates to false for it — treating the worst possible result as if it never
	/// exceeded the threshold. TNTC counts as an exceedance too.
	/// Bacteria set was originally just קוליפורם צואתי / E.coli MUG (the two fecal-coliform
	/// indicators); סטרפטוקוק/אנטרוקוק ממוצא צואתי was added once [Enterococcus EU Standard
	/// (Good)] established 400 as its threshold too (EU Bathing Water Directive, no Israeli
	/// standard found — see that measure's comment) — otherwise this measure and everything
	/// downstream of it ([Exceedance %], [Positive Sample Count], the map page's exceedance
	/// cards) silently returns BLANK whenever a page/slicer is filtered to just that bacteria,
	/// since KEEPFILTERS against the old two-item set intersects to nothing.
	/// Wrapped in an outer CALCULATE that REMOVEFILTERS the Exceedance Bucket column itself —
	/// without it, selecting "Below 400" in the control panel's Exceedance Bucket slicer
	/// pre-excludes every row this measure is trying to find, making it structurally impossible
	/// to ever count an exceedance while that slicer is pinned to one side (and the mirror image
	/// for "Above 400" vs [Positive Sample Count]/[Cleanliness Score]) — that's what made a
	/// heavily polluted site (multiple 10,000+ readings and TNTC) read as "100% תקינות" once its
	/// one compliant sample got isolated by an Exceedance Bucket = Below 400 filter. Must be a
	/// *nested* CALCULATE, not a sibling filter argument on the same CALCULATE as the FILTER()
	/// below — DAX evaluates all of one CALCULATE's filter arguments against the pre-CALCULATE
	/// context simultaneously, so REMOVEFILTERS needs its own outer CALCULATE for the inner
	/// FILTER(FactRiverPollution, ...) to actually see the bucket filter already lifted.
	measure 'Exceedance Count' =
			CALCULATE(
			    CALCULATE(
			        [Sample Count],
			        FILTER(
			            FactRiverPollution,
			            FactRiverPollution[Result_Numeric] > 400 || FactRiverPollution[Result_Qualifier] = "TNTC"
			        ),
			        KEEPFILTERS( DimBacterialIndex[Bacterial index] IN {"קוליפורם צואתי", "E.coli MUG", "סטרפטוקוק/אנטרוקוק ממוצא צואתי"})
			    ),
			    REMOVEFILTERS(FactRiverPollution[Exceedance Bucket])
			)
		formatString: 0
		lineageTag: 63cf2101-5b37-4ef9-8970-3f871811c7ff

	measure 'TNTC Ceiling' =
			VAR MaxReal =
			    CALCULATE(
			        MAX(FactRiverPollution[Result_Numeric]),
			        ALLSELECTED(DimDate),
			        ALLSELECTED(DimBacterialIndex)
			    )
			RETURN
			    IF(ISBLANK(MaxReal), 6000, MaxReal * 1.15)
		formatString: 0
		lineageTag: 15943805-71e8-47f9-adda-4cdd204a2053

	measure 'CFU Plot Value' =
			VAR RowsInContext = COUNTROWS(FactRiverPollution)
			VAR NumericMax = MAX(FactRiverPollution[Result_Numeric])
			RETURN
			    IF(
			        RowsInContext = 0,
			        BLANK(),
			        IF(ISBLANK(NumericMax), [TNTC Ceiling], NumericMax)
			    )
		formatString: 0
		lineageTag: 2c122632-75b7-4320-80a3-c4ebfc16e750

	measure 'Is TNTC Cell' =
