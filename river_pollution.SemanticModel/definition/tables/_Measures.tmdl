			            Bact = "E.coli MUG", "#436e67",
			            Bact = "סטרפטוקוק/אנטרוקוק ממוצא צואתי", "#6c9585",
			            "#52514e"
			        )
			    )
		lineageTag: e83e001f-a206-4a5a-a9a2-6915f978e421

	measure 'TNTC Flag' = IF([Is TNTC Cell] = 1, "TNTC — off-scale (shown above this chart's real max)", "Measured")
		lineageTag: 54cc7401-f9cb-4062-bef0-96a96c0ca21d

	measure 'Max value NON TNTC' = CALCULATE(MAX(FactRiverPollution[Result_Numeric]) , REMOVEFILTERS(FactRiverPollution)) * 1.15
