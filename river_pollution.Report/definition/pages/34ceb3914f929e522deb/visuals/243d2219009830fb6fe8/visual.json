  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "קוליפורם צואתי",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Calibri",
                      "fontSize": "20pt",
                      "color": "#233a48"
                    }
                  }
                ],
                "horizontalTextAlignment": "right"
              },
              {
                "textRuns": [
                  {
                    "value": "Fecal Coliform",
                    "textStyle": {
                      "fontFamily": "Calibri",
                      "fontSize": "14pt",
                      "color": "#436e67"
                    }
                  }
                ],
                "horizontalTextAlignment": "right"
              },
              {
                "textRuns": [
                  {
                    "value": "קבוצת חיידקים המצויה במערכת העיכול של בני אדם ובעלי חיים בעלי דם חם. נוכחותם במים היא הסימן הכללי ביותר לזיהום צואתי אפשרי.",
                    "textStyle": {
                      "fontFamily": "Calibri",
                      "fontSize": "20pt"
                    }
                  }
                ],
                "horizontalTextAlignment": "right"
              },
              {
                "textRuns": [
                  {
                    "value": "למה זה בעייתי: זיהום צואתי עלול לשאת גם חיידקים, נגיפים וטפילים מחוללי מחלות. מגע עם מים מזוהמים עלול לגרום למחלות מעיים ושלשולים, וכן לזיהומים בעור, בעיניים ובאוזניים.",
                    "textStyle": {
                      "fontFamily": "Calibri",
                      "fontSize": "20pt"
                    }
                  }
                ],
                "horizontalTextAlignment": "right"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "E.coli MUG",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Calibri",
                      "fontSize": "20pt",
                      "color": "#233a48"
                    }
                  }
                ],
                "horizontalTextAlignment": "right"
              },
              {
                "textRuns": [
                  {
                    "value": "Escherichia coli",
                    "textStyle": {
                      "fontFamily": "Calibri",
                      "fontSize": "14pt",
                      "color": "#436e67"
                    }
                  }
                ],
                "horizontalTextAlignment": "right"
              },
              {
                "textRuns": [
                  {
                    "value": "מין חיידק ספציפי מתוך קבוצת הקוליפורם הצואתי, כמעט בלעדי למערכת העיכול של בני אדם ובעלי חיים, ולכן מדד מדויק יותר לזיהום צואתי טרי.",
                    "textStyle": {
                      "fontFamily": "Calibri",
                      "fontSize": "20pt"
                    }
                  }
                ],
                "horizontalTextAlignment": "right"
              },
              {
                "textRuns": [
                  {
                    "value": "למה זה בעייתי: ריכוזים גבוהים מצביעים על זיהום קרוב במקור (למשל שפכים או נגר חקלאי) ועל סיכון בריאותי ישיר לאנשים הבאים במגע עם המים. בדוח זה, ערך מעל 400 CFU/100 מ\"ל נחשב לחריגה מהסף המומלץ.",
                    "textStyle": {
                      "fontFamily": "Calibri",
                      "fontSize": "20pt"
                    }
                  }
                ],
                "horizontalTextAlignment": "right"
              },
              {
                "textRuns": [
                  {
                    "value": ""
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "סטרפטוקוק/אנטרוקוק ממקור צואתי",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Calibri",
                      "fontSize": "20pt",
                      "color": "#233a48"
                    }
                  }
                ],
                "horizontalTextAlignment": "right"
              },
              {
                "textRuns": [
                  {
                    "value": "Fecal Streptococcus / Enterococcus",
                    "textStyle": {
                      "fontFamily": "Calibri",
                      "fontSize": "14pt",
                      "color": "#436e67"
                    }
                  }
                ],
                "horizontalTextAlignment": "right"
              },
              {
                "textRuns": [
                  {
                    "value": "קבוצת חיידקים נוספת שמקורה במעי, עמידה יותר בסביבה (כולל מים מלוחים) ושורדת זמן רב יותר מאשר קוליפורם צואתי. משמשת לאישור ולחיזוק הממצא כאשר יש חשד לזיהום.",
                    "textStyle": {
                      "fontFamily": "Calibri",
                      "fontSize": "20pt"
                    }
                  }
                ],
                "horizontalTextAlignment": "right"
              },
              {
                "textRuns": [
                  {
                    "value": "למה זה בעייתי: כמו יתר המדדים, נוכחות גבוהה מעידה על זיהום צואתי ופוטנציאל למחלות. שילוב של כמה אינדיקטורים יחד מגביר את מהימנות האבחנה של הזיהום.",
                    "textStyle": {
                      "fontFamily": "Calibri",
                      "fontSize": "20pt"
                    }
                  }
                ],
                "horizontalTextAlignment": "right"
              }
            ]
          }
        }
      ]
    },
